<!DOCTYPE html>
<html lang="<%= locale %>">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Комитет Ингушской Независимости - Главная</title>
    
    <%- include('./partials/seo-meta', {
        title: 'Комитет Ингушской Независимости - Официальный сайт',
        description: 'Официальный сайт Комитета Ингушской Независимости. Мы стремимся сохранять и развивать культурное наследие ингушского народа, защищать его интересы и права.',
        keywords: 'Ингушетия, комитет, независимость, культура, наследие, права, ингушский народ, история, традиции',
        req: typeof req !== 'undefined' ? req : { originalUrl: '/' }
    }) %>
    
    <link rel="stylesheet" href="/css/main-fixed.css">
    <link rel="stylesheet" href="/css/components/navigation.css">
    <!-- Добавляем Font Awesome для иконок -->
    <link rel="stylesheet" href="/css/fontawesome/all.min.css">
    <link rel="icon" href="/favicon.ico" type="image/x-icon">

    <%- include('./partials/google-analytics') %>

    <!-- Navigation script -->
    <script src="/js/components/navigation.js" defer></script>
</head>
<body>
    <!-- Фоновое изображение с горами -->
    <div class="page-background"></div>
    
    <div class="container">
        <header class="fade-in delay-1" role="banner">
            <div class="logo">
                <img src="/img/logo.png" alt="Логотип Комитета Ингушской Независимости - изображение герба" width="640" height="640">
            </div>
            <h1 class="site-title">Комитет Ингушской Независимости</h1>
        </header>


        <%- include('./partials/navigation') %>
        
<main role="main">
    <section class="hero-section fade-in delay-3" aria-labelledby="hero-heading">
        <h2 id="hero-heading">Добро пожаловать</h2>
        <p class="hero-text">Официальный сайт комитета ингушской независимости</p>
        <div class="button-group" role="group" aria-label="Основные действия">
            <a href="/about" class="btn btn-primary btn-icon" aria-label="Узнать больше о комитете">
                <i class="fas fa-info-circle" aria-hidden="true"></i> О комитете
            </a>
            <a href="/contact" class="btn btn-glow" aria-label="Связаться для сотрудничества">
                Присоединиться к нам
            </a>
        </div>
    </section>

    <section class="featured-content fade-in delay-4" aria-label="Основные разделы сайта">
        <div class="featured-box">
            <div class="icon-wrapper" aria-hidden="true">
                <i class="fas fa-users fa-2x"></i>
            </div>
            <h3>Наша деятельность</h3>
            <p>Познакомьтесь с текущими проектами и направлениями деятельности комитета.</p>
            <a href="/activities" class="btn btn-secondary" aria-label="Узнать о деятельности комитета">Подробнее</a>
        </div>

        <div class="featured-box">
            <div class="icon-wrapper" aria-hidden="true">
                <i class="fas fa-handshake fa-2x"></i>
            </div>
            <h3>Сотрудничество</h3>
            <p>Вы можете присоединиться к нашей деятельности или предложить сотрудничество.</p>
            <a href="/contact" class="btn btn-secondary" aria-label="Перейти к форме контактов">Связаться с нами</a>
        </div>
    </section>

    <% if (posts && posts.length > 0) { %>
    <section class="home-news fade-in delay-5" aria-label="Последние новости">
        <h2><i class="fas fa-newspaper" aria-hidden="true"></i> Последние новости</h2>
        <div class="home-news-grid">
            <% posts.forEach(function(post) { %>
                <article class="home-news-card">
                    <% if (post.media && post.media.length > 0) { %>
                        <div class="home-news-image">
                            <img src="<%= post.media[0] %>" alt="Фото новости" loading="lazy">
                        </div>
                    <% } %>
                    <div class="home-news-body">
                        <time class="home-news-date" datetime="<%= new Date(post.date).toISOString() %>">
                            <i class="far fa-calendar-alt" aria-hidden="true"></i>
                            <%= new Date(post.date).toLocaleDateString('ru-RU', { year: 'numeric', month: 'long', day: 'numeric' }) %>
                        </time>
                        <div class="home-news-text">
                            <%- post.text ? post.text.replace(/<br\s*\/?>/gi, ' ').replace(/<[^>]+>/g, '').replace(/\s+/g, ' ').trim().substring(0, 150) + (post.text.replace(/<[^>]+>/g, '').length > 150 ? '...' : '') : '' %>
                        </div>
                    </div>
                </article>
            <% }); %>
        </div>
        <div class="home-news-more">
            <a href="/news" class="btn btn-primary btn-icon" aria-label="Перейти ко всем новостям">
                <i class="fas fa-arrow-right" aria-hidden="true"></i> Все новости
            </a>
        </div>
    </section>
    <% } %>
</main>

<%- include('./partials/footer') %>
</div>

</body>
</html>
